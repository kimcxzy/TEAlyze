# ---------------------------------------------------------------------
# TEAlyze — backend (API que fala com o SQL Server em Docker)
# Copie para `.env` e ajuste se necessário:  cp .env.example .env
# ---------------------------------------------------------------------

PORT=3000

# Banco de dados (container Docker do SQL Server)
# DB_HOST=localhost   -> backend rodando na sua máquina (npm start)
# DB_HOST=sqlserver   -> backend rodando dentro do docker compose
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=*123456HAS*
DB_NAME=TEALYZE
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Aplicar database/01_schema.sql + 02_app_extensions.sql na inicialização
DB_RUN_MIGRATIONS=true
# Criar os logins de teste (3 profissionais se o banco estiver sem nenhum + 1 cuidador)
DB_RUN_SEED=true

# Espera pelo container do SQL Server (ele leva ~20s para aceitar conexões)
DB_WAIT_RETRIES=60
DB_WAIT_DELAY_MS=3000

# Sessões (dias de validade do token)
TOKEN_TTL_DAYS=30

# --- OCR de laudo por IA (OPCIONAL: única integração externa) ----------
# Provedor padrão: Google Gemini, que tem plano GRATUITO (sem cartão).
#   1) Abra https://aistudio.google.com/apikey e crie uma chave
#   2) Cole abaixo em OCR_API_KEY e reinicie o backend
# Sem chave, o laudo é salvo normalmente e os campos podem ser preenchidos
# à mão; a checagem de fraude continua rodando contra o banco.
# ATENÇÃO (LGPD): no plano gratuito o Google pode usar o conteúdo enviado para
# melhorar seus produtos. Laudos são dados de saúde — para uso real, prefira um
# plano pago/provedor com termos de privacidade adequados.
OCR_API_KEY=
# Deixe os três abaixo VAZIOS para usar o padrão (gemini). Só preencha para trocar
# de provedor (gemini | openai) ou apontar para outro serviço compatível com a API
# da OpenAI (OCR_API_URL + OCR_MODEL; vários modelos separados por vírgula).
OCR_PROVIDER=
OCR_API_URL=
OCR_MODEL=
